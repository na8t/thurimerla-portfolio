---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const {
  title = 'Naveen Thurimerla — Senior Cloud Data & AI Platform Engineer',
  description = 'Senior Cloud Data & Platform Engineer with 10+ years architecting scalable AI/ML systems, data pipelines, and cloud infrastructure on AWS and Azure.',
} = Astro.props;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="description" content={description} />
<meta http-equiv="X-Content-Type-Options" content="nosniff" />
<meta http-equiv="X-Frame-Options" content="DENY" />
<meta name="referrer" content="strict-origin-when-cross-origin" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:image" content="/profile.jpg" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content="/profile.jpg" />
<title>{title}</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
<script is:inline>
  const s = typeof localStorage !== 'undefined' && localStorage.getItem('theme');
  const d = s ? s === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
  document.documentElement.classList.toggle('theme-dark', d);
  if (typeof localStorage !== 'undefined') {
    new MutationObserver(() =>
      localStorage.setItem('theme', document.documentElement.classList.contains('theme-dark') ? 'dark' : 'light')
    ).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  }
</script>
