---
import Icon from './Icon.astro';
import type { iconPaths } from './IconPaths';
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
  { label: 'About',      href: '#about'      },
  { label: 'Skills',     href: '#skills'     },
  { label: 'Projects',   href: '#projects'   },
  { label: 'Contact',    href: '#contact'    },
] as const;

const iconLinks: { label: string; href: string; icon: keyof typeof iconPaths }[] = [
  { label: 'GitHub',   href: 'https://github.com/na8t',                   icon: 'github-logo'   },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/naveenthurimerla',  icon: 'linkedin-logo' },
];
---

<header class="site-header">
  <div class="header-inner wrapper">
    <a href="/" class="brand" aria-label="Naveen Thurimerla home">
      <span class="brand-mark">NT</span>
      <span class="brand-name">Naveen Thurimerla</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      {navLinks.map(({ label, href }) => (
        <a href={href} class="nav-link">{label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <div class="socials">
        {iconLinks.map(({ href, icon, label }) => (
          <a href={href} class="social-icon" aria-label={label} target="_blank" rel="noopener noreferrer">
            <Icon icon={icon} />
          </a>
        ))}
      </div>
      <ThemeToggle />
      <menu-button>
        <template>
          <button class="hamburger" aria-expanded="false" aria-label="Open menu">
            <Icon icon="list" />
          </button>
        </template>
      </menu-button>
    </div>
  </div>

  <div id="mobile-menu" hidden>
    <nav aria-label="Mobile">
      {navLinks.map(({ label, href }) => (
        <a href={href} class="mobile-link">{label}</a>
      ))}
    </nav>
    <div class="mobile-socials">
      {iconLinks.map(({ href, icon, label }) => (
        <a href={href} aria-label={label} target="_blank" rel="noopener noreferrer" class="social-icon">
          <Icon icon={icon} /><span>{label}</span>
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  class MenuButton extends HTMLElement {
    connectedCallback() {
      const tmpl = this.querySelector('template');
      if (!tmpl) return;
      const btn = tmpl.content.firstElementChild as HTMLButtonElement;
      const menu = document.getElementById('mobile-menu');
      if (!btn || !menu) return;
      btn.addEventListener('click', () => {
        const open = !menu.hidden;
        menu.hidden = open;
        btn.setAttribute('aria-expanded', String(!open));
      });
      menu.querySelectorAll('a').forEach(a =>
        a.addEventListener('click', () => { menu.hidden = true; btn.setAttribute('aria-expanded','false'); })
      );
      this.appendChild(btn);
    }
  }
  customElements.define('menu-button', MenuButton);
</script>

<style>
.site-header {
  position: sticky; top: 0; z-index: 100;
  background-color: var(--gray-999);
  border-bottom: 1px solid var(--gray-100);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}
.header-inner {
  display: flex; align-items: center;
  justify-content: space-between;
  height: 4rem; gap: 1rem;
}
.brand {
  display: flex; align-items: center;
  gap: .625rem; text-decoration: none; flex-shrink: 1;
  min-width: 0;
}
.brand-mark {
  display: inline-flex; align-items: center; justify-content: center;
  width: 2rem; height: 2rem; border-radius: .5rem;
  background: var(--gradient-accent);
  color: var(--accent-text-over);
  font-family: var(--font-brand); font-weight: 800; font-size: .75rem;
  flex-shrink: 0;
}
.brand-name {
  font-family: var(--font-brand); font-weight: 700;
  font-size: var(--text-base); color: var(--gray-0);
  letter-spacing: -.02em;
  white-space: nowrap;
}
.desktop-nav { display: none; align-items: center; gap: .125rem; }
.nav-link {
  padding: .375rem .875rem; border-radius: .5rem;
  font-size: var(--text-sm); font-weight: 600;
  font-family: var(--font-brand); color: var(--gray-300);
  text-decoration: none;
  transition: color var(--theme-transition), background-color var(--theme-transition);
}
.nav-link:hover { color: var(--gray-0); background-color: var(--gray-100); }
.header-actions { display: flex; align-items: center; gap: .5rem; flex-shrink: 0; }
.socials { display: none; align-items: center; gap: .125rem; }
.social-icon {
  display: flex; align-items: center; gap: .4rem;
  padding: .375rem; border-radius: .5rem;
  color: var(--gray-400); text-decoration: none; font-size: 1.15rem;
  transition: color var(--theme-transition), background-color var(--theme-transition);
}
.social-icon:hover { color: var(--accent-regular); background-color: var(--accent-overlay); }
.hamburger {
  display: flex; align-items: center; justify-content: center;
  width: 2.25rem; height: 2.25rem;
  border: 1px solid var(--gray-100); border-radius: .5rem;
  background: transparent; color: var(--gray-300);
  font-size: 1.25rem; cursor: pointer;
  transition: color var(--theme-transition), border-color var(--theme-transition);
}
.hamburger:hover { color: var(--gray-0); border-color: var(--gray-300); }
#mobile-menu {
  border-top: 1px solid var(--gray-100);
  padding: 1rem 1.5rem 1.5rem;
  display: flex; flex-direction: column; gap: 1.25rem;
  background: var(--gray-999);
}
#mobile-menu[hidden] {
  display: none !important;
}
#mobile-menu nav { display: flex; flex-direction: column; gap: .25rem; }
.mobile-link {
  display: block; padding: .625rem .75rem; border-radius: .5rem;
  font-family: var(--font-brand); font-weight: 600;
  font-size: var(--text-md); color: var(--gray-300); text-decoration: none;
  transition: color var(--theme-transition), background-color var(--theme-transition);
}
.mobile-link:hover { color: var(--gray-0); background-color: var(--gray-100); }
.mobile-socials {
  display: flex; gap: .75rem;
  padding-top: .5rem; border-top: 1px solid var(--gray-100);
}
.mobile-socials .social-icon {
  font-size: var(--text-sm); font-family: var(--font-brand); font-weight: 600;
  color: var(--gray-400); padding: .4rem .75rem .4rem .5rem;
  border: 1px solid var(--gray-100); border-radius: 999rem;
}
.mobile-socials .social-icon:hover {
  border-color: var(--accent-regular); color: var(--accent-regular);
  background-color: var(--accent-overlay);
}
@media(min-width:50em){
  .desktop-nav{ display: flex; }
  .socials{ display: flex; }
  .hamburger{ display: none !important; }
  #mobile-menu{ display: none !important; }
  .brand-name{ font-size: var(--text-md); }
}
</style>
